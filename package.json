{
  "name": "@bedrocknexus/hub",
  "version": "0.1.0",
  "description": "The open-source Bedrock Nexus community platform.",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://bedrocknexus.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BedrockNexus/hub.git"
  },
  "bugs": {
    "url": "https://github.com/BedrockNexus/hub/issues"
  },
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev": "next dev",
    "dev:prod-data": "node scripts/dev-prod-data.mjs",
    "env:check": "node scripts/check-env.mjs",
    "build": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true next build",
    "cdn:deploy": "wrangler deploy --config infrastructure/cdn-root/wrangler.jsonc",
    "cdn:dev": "wrangler dev --config infrastructure/cdn-root/wrangler.jsonc",
    "cdn:test": "bun test infrastructure/cdn-root",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:framework": "eslint . --ignore-pattern \"convex/_generated/**\" --ignore-pattern \"convex/betterAuth/_generated/**\"",
    "test": "bun test ./lib/*.test.ts convex/lib infrastructure/cdn-root && vitest run",
    "test:functions": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test:e2e": "playwright test",
    "test:e2e:publishing": "cross-env E2E_PUBLISHING=1 playwright test e2e/publishing.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
