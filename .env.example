# Where each variable lives is listed in scripts/env-names.mjs and enforced by
# `bun run env:check`. Locally there are two files, both ignored by git:
#   .env.local      the dev deployment, always (copy this template)
#   .env.prod-view  the production NEXT_PUBLIC_CONVEX_URL and
#                   NEXT_PUBLIC_CONVEX_SITE_URL, used only by
#                   `bun run dev:prod-data` to view production data locally
# Do not switch .env.local to production. For production Convex commands add
# `--prod`.

# =============================================================================
# Next.js app (.env.local locally; Coolify environment / build args in prod)
# Only these values are read by the Next.js server or bundled into the client.
# =============================================================================
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Public status API used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Same high-entropy values must also be set in Convex (see below).
DOWNLOAD_REDIRECT_SECRET=
AUTH_PROXY_SECRET=

# Optional: client address detection behind proxies (lib/client-address.ts).
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=cf-connecting-ip

# Convex CLI. CONVEX_DEPLOYMENT is written by `bunx convex dev` and must be a
# dev deployment. CONVEX_DEPLOY_KEY is only for CI/preview deploy jobs: never
# put it here, it redirects every Convex command to its own deployment.
CONVEX_DEPLOYMENT=

# =============================================================================
# Convex deployment (set with `npx convex env set NAME value` or the dashboard)
# Do NOT put these in .env/.env.local: Next.js never reads them, and Convex
# functions only see values stored in the deployment.
# =============================================================================
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=
# AUTH_PROXY_SECRET=              (same value as Next.js)
# DOWNLOAD_REDIRECT_SECRET=       (same value as Next.js)
#
# Email (Resend component)
# RESEND_API_KEY=
# EMAIL_FROM=Bedrock Nexus <noreply@example.com>
#
# Plugin registry: the BedrockNexus GitHub App (not a sign-in provider).
# Its webhook URL is <Convex site URL>/github/webhooks and its callback URL
# is <site>/api/github/callback.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
#
# Bedrock Nexus API
# BEDROCKNEXUS_API_KEY=
# BEDROCKNEXUS_API_URL=https://api.bedrocknexus.com
# SERVER_VERIFICATION_API_URL=https://api.bedrocknexus.com
# ARTIFACT_VALIDATOR_URL=https://validator.example.com
# ARTIFACT_VALIDATOR_API_KEY=     (optional; defaults to BEDROCKNEXUS_API_KEY)
#
# Cloudflare R2 (two buckets: public CDN and private uploads)
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_CDN_BUCKET=bedrocknexus-prod
# R2_UPLOADS_BUCKET=bedrocknexus-uploads-prod
# R2_CDN_PUBLIC_URL=https://cdn.bedrocknexus.com
